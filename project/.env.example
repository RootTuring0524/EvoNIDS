NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_USE_MOCK_API=true
NUXT_BACKEND_API_BASE=http://127.0.0.1:8000/api/v1
NUXT_SENSOR_INGEST_TOKEN=
NUXT_BACKEND_ADMIN_TOKEN=

# Optional console login password. Empty = authentication disabled (console
# open; intended for local development and demos). When set, every console
# page and /api/** BFF route requires login.
NUXT_CONSOLE_PASSWORD=

# Console session lifetime in hours (default 24). Only applies when
# NUXT_CONSOLE_PASSWORD is set.
NUXT_CONSOLE_SESSION_HOURS=24

# Console login brute-force protection (defaults: 5 failed attempts per 15
# minutes per remote address; lockout lasts one window). Process-local.
NUXT_CONSOLE_LOGIN_MAX_ATTEMPTS=5
NUXT_CONSOLE_LOGIN_WINDOW_SECONDS=900

# Set to "true" only when the console is served over HTTPS: marks the session
# cookie Secure.
NUXT_CONSOLE_COOKIE_SECURE=false

# Console login/logout events are forwarded to the backend audit stream
# (POST /api/v1/audit/console). Forwarding requires NUXT_BACKEND_ADMIN_TOKEN;
# without it, login still works but console auth events are not persisted.
NUXT_DEEPSEEK_API_BASE=
NUXT_DEEPSEEK_API_KEY=
NUXT_DEEPSEEK_MODEL=

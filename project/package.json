{
  "name": "evonids-console",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "lint-staged:check": "lint-staged",
    "hooks:install": "husky",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/nuxt": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.5",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-router": "5.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": "prettier --write"
  }
}

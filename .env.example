# =============================================================================
# EvoNIDS root environment template
# -----------------------------------------------------------------------------
# Copy to .env and fill in:  Copy-Item .env.example .env
# Never commit .env - it holds tokens and optional API keys.
# The DeepSeek API key is OPTIONAL: mock mode works without it.
#
# Consumers:
#   - docker compose (this directory) reads POSTGRES_*, API_PORT, WEB_PORT,
#     EVONIDS_ADMIN_API_TOKEN, EVONIDS_SENSOR_INGEST_TOKEN,
#     EVONIDS_TRAINING_CPU_THREADS and the NUXT_* variables below.
#   - start-demo.ps1 reads only the three NUXT_DEEPSEEK_* variables from
#     the root .env and generates its own ephemeral tokens.
# All values below are placeholders; replace "change-me" before real use.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Runtime profile: development or production.
EVONIDS_ENVIRONMENT=development

# SQLAlchemy database URL. Local development default: sqlite:///./evonids.db.
# In Docker Compose the API builds this automatically from POSTGRES_* below;
# leave empty here.
EVONIDS_DATABASE_URL=

# Create tables on startup (development/demo convenience; Docker Compose
# forces false and expects Alembic migrations).
EVONIDS_AUTO_CREATE_DB=

# Application log level (INFO, DEBUG, WARNING, ERROR).
EVONIDS_LOG_LEVEL=INFO

# JSON array of CORS origins allowed for the Nuxt console.
EVONIDS_CORS_ORIGINS=["http://localhost:3000"]

# Admin token protecting privileged writes (rule writes, alert disposition,
# dataset registration, knowledge evidence writes). Required outside
# development. Must match NUXT_BACKEND_ADMIN_TOKEN. Use a long random string.
EVONIDS_ADMIN_API_TOKEN=change-me

# Token required for EVE ingestion and sensor heartbeat requests outside
# development. Must match NUXT_SENSOR_INGEST_TOKEN. Use a different long
# random string from the admin token.
EVONIDS_SENSOR_INGEST_TOKEN=change-me

# Root directory holding registered CSV/CSV.GZ datasets. Docker Compose
# mounts ./backend/datasets read-only; local default is ./datasets.
EVONIDS_DATASET_ROOT=

# Directory for trained model artifacts. Docker Compose uses the managed
# evonids-models volume; local default is ./model-artifacts.
EVONIDS_MODEL_ARTIFACT_ROOT=

# Cap CPU threads used by training jobs (0 = runtime default).
EVONIDS_TRAINING_CPU_THREADS=0

# ---------------------------------------------------------------------------
# Online detection policy (Phase 3, see docs/adr/0010-online-detection-and-fusion.md)
# ---------------------------------------------------------------------------
# disabled = no model inference; shadow = record signals/assessments only
# (DEFAULT, no alerts, flow verdict unchanged); enabled = fused decision raises
# alerts and updates flow verdicts. Only enable after an online-contract model
# has passed the ADR-0009 evaluation protocol.
EVONIDS_DETECTION_MODE=shadow

# Collector batch limits enforced by the server.
EVONIDS_COLLECTOR_MAX_BATCH_EVENTS=50000
EVONIDS_COLLECTOR_MAX_PAYLOAD_BYTES=33554432

# Sensor health thresholds (seconds) used for online/degraded/offline states.
EVONIDS_SENSOR_ONLINE_SECONDS=120
EVONIDS_SENSOR_DEGRADED_SECONDS=900

# Sensor-side collector (read by `python -m app.collector.cli`). The token is a
# sensor-scope API key, never the admin token. See docs/collector.md.
EVONIDS_SENSOR_TOKEN=
EVONIDS_COLLECTOR_SPOOL=./collector-spool

# ---------------------------------------------------------------------------
# LLM gateway and hybrid retrieval (Phase 4, see docs/adr/0011-...)
# ---------------------------------------------------------------------------
# disabled = platform runs fully without any model provider (DEFAULT);
# openai-compatible/deepseek = any OpenAI-compatible endpoint (DeepSeek, vLLM,
# Ollama); mock = deterministic test/demo provider, REFUSED in production.
EVONIDS_LLM_PROVIDER=disabled
EVONIDS_LLM_BASE_URL=
EVONIDS_LLM_API_KEY=
# Model ID that must exist upstream; verify with POST /api/v1/llm/probe.
EVONIDS_LLM_MODEL=
EVONIDS_LLM_TIMEOUT_SECONDS=30
EVONIDS_LLM_MAX_ATTEMPTS=3
EVONIDS_LLM_MAX_CONCURRENCY=4
# Budgets in USD. Cost is only reported when the model price is known.
EVONIDS_LLM_RUN_BUDGET_USD=0.25
EVONIDS_LLM_DAILY_BUDGET_USD=5.0
EVONIDS_LLM_MAX_OUTPUT_TOKENS=1200

# Embeddings: "hashing" is an offline deterministic lexical embedder (not a
# semantic model); "openai-compatible" uses a real embedding endpoint.
EVONIDS_EMBEDDING_PROVIDER=hashing
EVONIDS_EMBEDDING_MODEL=hashing-256-v1
EVONIDS_EMBEDDING_DIMENSIONS=256

# ---------------------------------------------------------------------------
# HTTP hardening (Phase 7). The rate limiter is per API process.
# ---------------------------------------------------------------------------
EVONIDS_RATE_LIMIT_ENABLED=true
EVONIDS_RATE_LIMIT_WRITE_PER_MINUTE=240
EVONIDS_RATE_LIMIT_INGEST_PER_MINUTE=1200
EVONIDS_MAX_JSON_BODY_BYTES=2097152

# Host port published for the FastAPI API (default 8000, bound to 127.0.0.1).
API_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose service: pgvector/pgvector:pg17)
# ---------------------------------------------------------------------------
# Database name created on first start.
POSTGRES_DB=evonids

# Database superuser name.
POSTGRES_USER=evonids

# Database password. CHANGE THIS before any non-local use.
POSTGRES_PASSWORD=change-me

# Host port published for PostgreSQL (default 5432, bound to 127.0.0.1).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Frontend BFF (Nuxt 4 server routes in project/server)
# ---------------------------------------------------------------------------
# Public base path the browser uses for BFF calls. Docker Compose sets /api.
NUXT_PUBLIC_API_BASE=/api

# true = deterministic in-browser mock demo; false = proxy through the BFF
# to the FastAPI API. Docker Compose sets false.
NUXT_PUBLIC_USE_MOCK_API=

# Server-side base URL of the FastAPI API: http://127.0.0.1:8000/api/v1 for
# local development or http://api:8000/api/v1 inside Docker Compose.
NUXT_BACKEND_API_BASE=

# Same value as EVONIDS_ADMIN_API_TOKEN; held server-side only. Docker
# Compose wires this automatically from the backend variable.
NUXT_BACKEND_ADMIN_TOKEN=

# Same value as EVONIDS_SENSOR_INGEST_TOKEN; held server-side only. Docker
# Compose wires this automatically from the backend variable.
NUXT_SENSOR_INGEST_TOKEN=

# Optional legacy analyst token; the analyst scope is normally issued as a DB
# API key through POST /api/v1/admin/api-keys instead.
EVONIDS_ANALYST_API_TOKEN=

# Optional console login password. Empty (default) = authentication disabled
# and the console stays open, which is intended for local development and
# demos. When set, every console page and /api/** BFF route requires login.
NUXT_CONSOLE_PASSWORD=

# Console session lifetime in hours (default 24). Only applies when
# NUXT_CONSOLE_PASSWORD is set.
NUXT_CONSOLE_SESSION_HOURS=24

# Console login brute-force protection (defaults: 5 failed attempts per 15
# minutes per remote address; lockout lasts one window). Process-local.
NUXT_CONSOLE_LOGIN_MAX_ATTEMPTS=5
NUXT_CONSOLE_LOGIN_WINDOW_SECONDS=900

# Mark the console session cookie Secure. Set "true" only when the console is
# served over HTTPS (docker-compose.prod.yml requires an explicit value).
NUXT_CONSOLE_COOKIE_SECURE=false

# Host port published for the Nuxt web console (default 3000, bound to
# 127.0.0.1).
WEB_PORT=3000

# Optional host/port used when serving the production build with
# `node .output/server/index.mjs` (see project/README.md).
NITRO_HOST=
NITRO_PORT=

# ---------------------------------------------------------------------------
# DeepSeek LLM (optional; server-side only, never exposed to the browser)
# ---------------------------------------------------------------------------
# Upstream OpenAI-compatible base URL, e.g. https://api.deepseek.com
NUXT_DEEPSEEK_API_BASE=

# DeepSeek API key. OPTIONAL - mock mode and the rest of the console work
# without it. Stored only in Nuxt server runtime config; never commit it and
# never send it to the browser.
NUXT_DEEPSEEK_API_KEY=

# Model ID that actually exists on your DeepSeek account. Verify it with the
# "validate upstream /models" action on the Platform Settings page.
NUXT_DEEPSEEK_MODEL=

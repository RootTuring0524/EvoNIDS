EVONIDS_ENVIRONMENT=development
EVONIDS_DATABASE_URL=sqlite:///./evonids.db
EVONIDS_AUTO_CREATE_DB=true
EVONIDS_LOG_LEVEL=INFO
EVONIDS_CORS_ORIGINS=["http://localhost:3000"]
EVONIDS_ADMIN_API_TOKEN=
# Required outside development for EVE ingestion and sensor heartbeat requests.
EVONIDS_SENSOR_INGEST_TOKEN=
# Optional legacy analyst-token; analyst scope is normally issued as a DB API key
# through POST /api/v1/admin/api-keys.
EVONIDS_ANALYST_API_TOKEN=
EVONIDS_DATASET_ROOT=./datasets
EVONIDS_MODEL_ARTIFACT_ROOT=./model-artifacts
# 0 uses the runtime default; set a positive value to cap CPU threads.
EVONIDS_TRAINING_CPU_THREADS=0

# ---------------------------------------------------------------------------
# Phase 3-7 additions (see docs/adr/0008, 0010, 0011 and docs/releases/v0.1.1.md)
# ---------------------------------------------------------------------------
# Online detection: disabled | shadow (default) | enabled
EVONIDS_DETECTION_MODE=shadow
EVONIDS_COLLECTOR_MAX_BATCH_EVENTS=50000
EVONIDS_COLLECTOR_MAX_PAYLOAD_BYTES=33554432
EVONIDS_SENSOR_ONLINE_SECONDS=120
EVONIDS_SENSOR_DEGRADED_SECONDS=900

# LLM gateway: disabled (default) | openai-compatible | deepseek | mock (refused in production)
EVONIDS_LLM_PROVIDER=disabled
EVONIDS_LLM_BASE_URL=
EVONIDS_LLM_API_KEY=
EVONIDS_LLM_MODEL=
EVONIDS_LLM_RUN_BUDGET_USD=0.25
EVONIDS_LLM_DAILY_BUDGET_USD=5.0

# Hybrid retrieval embedder: hashing (offline lexical) | openai-compatible
EVONIDS_EMBEDDING_PROVIDER=hashing
EVONIDS_EMBEDDING_MODEL=hashing-256-v1
EVONIDS_EMBEDDING_DIMENSIONS=256

# HTTP hardening (per-process limiter)
EVONIDS_RATE_LIMIT_ENABLED=true
EVONIDS_RATE_LIMIT_WRITE_PER_MINUTE=240
EVONIDS_RATE_LIMIT_INGEST_PER_MINUTE=1200
EVONIDS_MAX_JSON_BODY_BYTES=2097152
